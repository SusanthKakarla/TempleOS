# Railway Postgres
DATABASE_URL=postgresql://user:password@host:port/database

# Session cookie signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Encrypts payment credentials at rest (Razorpay Key Secret, Webhook Secret,
# Partner OAuth access/refresh tokens) — see lib/payments/crypto.ts. Must be
# a base64-encoded 32-byte AES-256 key (generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PAYMENT_ENCRYPTION_KEY=

# Firebase Admin SDK (server-side token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client SDK (browser phone OTP login)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Local tenant login host override. Must match a tenant_domains.hostname row;
# Local-only override for tenant login on localhost. Use the hostname of a real
# tenant created through `/super-admin/temples/new` or `npm run provision:temple`.
TEMPLEOS_LOCAL_TENANT_HOST=your-temple.trytempleos.com

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Optional — read by `npm run provision:temple` (scripts/provision-temple.mts)
# as CLI fallback values so you don't have to pass --whatsapp-phone-number,
# --meta-phone-number-id, --meta-business-account-id on every invocation.
# Per-tenant WhatsApp connections themselves live in the whatsapp_accounts
# table, not in env vars.
WHATSAPP_PHONE_NUMBER=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

# Meta WhatsApp Embedded Signup (tenant self-connect, Chatbot Settings page).
# TempleOS acts as a Meta Tech Provider: WHATSAPP_ACCESS_TOKEN above is a
# single platform-level System User token used for every connected tenant's
# Graph API calls once Embedded Signup grants that System User access to
# their WhatsApp Business Account — no per-tenant token is ever stored.
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
WHATSAPP_APP_SECRET=

# Meta's JS SDK doesn't support wildcard Allowed Domains, so the actual
# FB.init()/FB.login() call always runs from this single fixed domain
# (app/whatsapp-onboarding) instead of the tenant's own subdomain — the
# tenant dashboard hands off here and gets handed back after connecting.
WHATSAPP_ONBOARDING_ORIGIN=https://trytempleos.com

# Bootstrap Super Admin (read once by `npm run seed`; no-ops if a Super Admin
# already exists, so it's safe to leave set on every deploy)
ADMIN_PHONE_NUMBER=
ADMIN_DISPLAY_NAME=

# Shared secret for Railway Cron to call /api/cron/process-event-notifications
# and the notification-engine cron routes below (same secret, all four).
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=

# Automated notification engine (migrations/013_notification_engine.sql).
# Needs three Railway Cron schedules configured in the Railway dashboard
# (not something this app can configure itself) — each a POST request with
# `Authorization: Bearer <CRON_SECRET>`, same as the existing
# process-event-notifications schedule:
#   /api/cron/process-notifications    every 15 min  — delivery + retries for every notification type
#   /api/cron/daily-birthday-check     once daily, ~08:00 tenant-local     — birthday wishes + priest reminders
#   /api/cron/event-reminders          hourly                              — day-before event reminders
#   /api/cron/reconcile-payments       nightly                             — detects/auto-resolves missed payment webhooks per connected tenant, and refreshes any Partner OAuth access token due to expire within 7 days

# Razorpay Partner OAuth (tenant self-connect via "Connect Razorpay", Payment
# Settings page) — the second connection method alongside manually pasting a
# Key ID/Key Secret. One platform-wide Partner application, same env-var
# pattern as the Meta WhatsApp Embedded Signup app above: "Partner Onboarding"
# is considered enabled/disabled purely based on whether these are set.
RAZORPAY_PARTNER_CLIENT_ID=
RAZORPAY_PARTNER_CLIENT_SECRET=
# Only needed if the OAuth redirect must go to a fixed domain different from
# the request's own host (mirrors WHATSAPP_ONBOARDING_ORIGIN's reasoning);
# leave unset to derive it from the incoming request automatically.
RAZORPAY_PARTNER_REDIRECT_URI=
# Signs the platform-level webhook at /api/webhooks/razorpay/partner, which
# every OAuth-connected tenant shares (manual-mode tenants keep their own
# per-tenant webhook secret, entered on their own Payment Settings page).
RAZORPAY_PARTNER_WEBHOOK_SECRET=

# ImageKit (image storage for notification media — event banners, greeting
# images, festival banners). Create a free account at imagekit.io and copy
# these three values from its dashboard (Developer options).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Donation campaign "Donate Now" link (lib/campaigns/donation-message.ts).
# A campaign's own donation_link_override always wins; otherwise the link
# sent in the donation_campaign_broadcast WhatsApp template is
# <this>/<campaignId>. Defaults to a demo endpoint if unset — swap this one
# value for a real payment gateway's base URL later without touching any
# notification/template code.

